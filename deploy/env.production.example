# Copy to /etc/ai-website-preflight.env on the server. Do not commit the live file.
# chmod 640 and chown root:preflight.
# NEXT_PUBLIC_APP_URL is inlined at build time. Source this file before `npm run build`.

NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN
DATABASE_PATH=/var/www/ai-website-preflight/data/preflight.db
LOG_LEVEL=info
BACKUP_DIR=/var/www/ai-website-preflight/backups
BACKUP_KEEP_DAYS=14

MAX_ACTIVE_SCANS=1

SCAN_RATE_LIMIT_IP_MAX=5
SCAN_RATE_LIMIT_IP_WINDOW_MS=600000
SCAN_RATE_LIMIT_HOST_MAX=3
SCAN_RATE_LIMIT_HOST_WINDOW_MS=600000
SCAN_RATE_LIMIT_MAX_KEYS=2048

MAX_ACTIVE_TOOL_RUNS=2

TOOL_RATE_LIMIT_IP_MAX=20
TOOL_RATE_LIMIT_IP_WINDOW_MS=600000
TOOL_RATE_LIMIT_HOST_MAX=8
TOOL_RATE_LIMIT_HOST_WINDOW_MS=600000
TOOL_RATE_LIMIT_MAX_KEYS=2048

# Enable only after Nginx overwrites X-Forwarded-For and X-Real-IP.
TRUST_PROXY_HEADERS=true
