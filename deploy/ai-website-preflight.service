[Unit]
Description=AI Website Preflight
After=network.target

[Service]
Type=simple
User=preflight
Group=preflight
WorkingDirectory=/var/www/ai-website-preflight/app
EnvironmentFile=/etc/ai-website-preflight.env
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
