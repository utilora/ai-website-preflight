# Application URL used for links and deployment configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite scan database path. Do not commit a real database.
DATABASE_PATH=./data/preflight.db

# debug, info, warn, or error
LOG_LEVEL=info

# Process-local concurrent scans. Default 1, hard-capped at 4.
MAX_ACTIVE_SCANS=1

# Public scan-create rate limits. Windows are milliseconds.
SCAN_RATE_LIMIT_IP_MAX=5
SCAN_RATE_LIMIT_IP_WINDOW_MS=600000
SCAN_RATE_LIMIT_HOST_MAX=3
SCAN_RATE_LIMIT_HOST_WINDOW_MS=600000
SCAN_RATE_LIMIT_MAX_KEYS=2048

# Only set true behind a reverse proxy that OVERWRITES X-Forwarded-For and X-Real-IP.
# Leave false/unset if the Node process can be reached directly; forged forwarding headers are ignored.
TRUST_PROXY_HEADERS=false

# Concurrent free-tool checks. Default 2, hard-capped at 4.
MAX_ACTIVE_TOOL_RUNS=2

# Free-tool rate limits. Windows are milliseconds.
TOOL_RATE_LIMIT_IP_MAX=20
TOOL_RATE_LIMIT_IP_WINDOW_MS=600000
TOOL_RATE_LIMIT_HOST_MAX=8
TOOL_RATE_LIMIT_HOST_WINDOW_MS=600000
TOOL_RATE_LIMIT_MAX_KEYS=2048
